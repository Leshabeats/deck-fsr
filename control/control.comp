#version 460
#extension GL_EXT_buffer_reference : require
#ifdef NONUNIFORM
#extension GL_EXT_nonuniform_qualifier : require
#endif

layout(local_size_x = 1) in;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer TextureIndex {
    uint slot;
};
layout(push_constant, std430) uniform Arguments {
    TextureIndex selection;
} args;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D inputs[2];
layout(set = 0, binding = 1, std430) writeonly buffer Result {
    uint packed_rgba;
} result;

void main() {
    uint slot = args.selection.slot;
#ifdef NONUNIFORM
    vec4 color = imageLoad(inputs[nonuniformEXT(slot)], ivec2(0));
#else
    vec4 color = imageLoad(inputs[slot], ivec2(0));
#endif
    result.packed_rgba = packUnorm4x8(color);
}
